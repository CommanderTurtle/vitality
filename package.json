{
  "name": "vitality",
  "version": "0.3.0",
  "description": "Wrap a standalone web directory in a production-ready Vite project.",
  "type": "module",
  "bin": {
    "vitality": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test --max-concurrency=1 tests/*.test.mjs",
    "prepack": "bun run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "vite",
    "scaffolder",
    "static-site",
    "github-pages",
    "bundler",
    "cli"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "tinyglobby": "^0.2.15",
    "typescript-parser": "npm:typescript@5.9.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
